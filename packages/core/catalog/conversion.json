      },
      {
        "type": "slider",
        "key": "margin",
        "labelKey": "opt.margin",
        "default": 0,
        "min": 0,
        "max": 72,
        "step": 1,
        "unit": "pt",
        "displayUnit": "mm",
        "section": "layout",
        "row": "b"
      },
      {
        "type": "color",
        "key": "background",
        "labelKey": "opt.images.background",
        "default": "#ffffff",
        "section": "layout"
      },
      {
        "type": "slider",
        "key": "imageQuality",
        "labelKey": "opt.compress.imageQuality",
        "default": 85,
        "min": 40,
        "max": 100,
        "step": 1,
        "unit": "percent",
        "section": "advanced"
      }
    ],
    "workflow": "conversion",
    "inputFormats": [
      "image"
    ],
    "outputFormats": [
      "pdf"
    ]
  },
