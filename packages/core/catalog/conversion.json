[
  {
    "id": "pdf-to-images",
    "nameKey": "tool.pdfToImages.name",
    "descKey": "tool.pdfToImages.desc",
    "category": "convert",
    "icon": "images",
    "order": 110,
    "accept": "application/pdf",
    "multiFile": true,
    "layout": "image-grid",
    "artifactKind": "image",
    "keywords": [
      "转图片",
      "png",
      "jpg"
    ],
    "fields": [
      {
        "type": "select",
        "key": "format",
        "labelKey": "opt.images.format",
        "default": "jpeg",
        "row": "a",
        "options": [
          {
            "value": "jpeg",
            "labelKey": "opt.images.jpeg"
          },
          {
            "value": "png",
            "labelKey": "opt.images.png"
          },
          {
            "value": "webp",
            "labelKey": "opt.images.webp"
          }
        ]
      },
      {
        "type": "slider",
        "key": "dpi",
        "labelKey": "opt.images.dpi",
        "default": 150,
        "min": 72,
        "max": 600,
        "step": 6,
        "unit": "dpi",
        "presets": [
          {
            "value": 96,
            "labelKey": "opt.images.dpi.screen"
          },
          {
            "value": 150,
            "labelKey": "opt.images.dpi.standard"
          },
          {
            "value": 300,
            "labelKey": "opt.images.dpi.print"
          }
        ],
        "section": "layout",
        "row": "a"
      },
      {
        "type": "slider",
        "key": "quality",
        "labelKey": "opt.images.quality",
        "default": 88,
        "min": 30,
        "max": 100,
        "step": 1,
        "unit": "percent",
        "presets": [
          {
            "value": 60,
            "labelKey": "opt.image.quality.small"
          },
          {
            "value": 85,
            "labelKey": "opt.image.quality.standard"
          },
          {
            "value": 95,
            "labelKey": "opt.image.quality.high"
          }
        ],
        "section": "layout",
        "showIf": {
          "field": "format",
          "in": [
            "jpeg",
            "webp"
          ]
        }
      },
      {
        "type": "boolean",
        "key": "transparentBackground",
        "labelKey": "opt.images.transparent",
        "default": false,
        "showIf": {
          "field": "format",
          "in": [
            "png",
            "webp"
          ]
        }
      },
      {
        "type": "pageRanges",
        "key": "pages",
        "labelKey": "opt.pages",
        "default": "all"
      }
    ],
    "workflow": "conversion",
    "inputFormats": [
      "pdf"
    ],
    "outputFormats": [
      "image"
    ]
  },
