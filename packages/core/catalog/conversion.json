            "labelKey": "opt.orientation.auto"
          },
          {
            "value": "portrait",
            "labelKey": "opt.orientation.portrait"
          },
          {
            "value": "landscape",
            "labelKey": "opt.orientation.landscape"
          }
        ]
      },
      {
        "type": "select",
        "key": "fit",
        "labelKey": "opt.images.fit",
        "default": "contain",
        "section": "layout",
        "row": "b",
        "options": [
          {
            "value": "contain",
            "labelKey": "opt.images.fitContain"
          },
          {
            "value": "cover",
            "labelKey": "opt.images.fitCover"
          },
          {
            "value": "actual",
            "labelKey": "opt.images.fitActual"
