{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoTools",
  "version": "0.1.0",
  "identifier": "app.potools.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @potools/web dev",
    "devUrl": "http://127.0.0.1:5199",
    "beforeBuildCommand": "pnpm --filter @potools/web build",
    "frontendDist": "../web/dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PoTools 工具箱",
        "width": 1240,
        "height": 820,
        "minWidth": 860,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost blob: data:; media-src 'self' data: blob:; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "publisher": "pohoc",
    "license": "MIT",
    "licenseFile": "../../LICENSE-INSTALLER.rtf",
    "shortDescription": "本机文件工具平台",
    "longDescription": "合并、拆分、组织、水印、压缩与格式转换，全部在本机完成。",
    "copyright": "© 2026 pohoc · MIT for PoTools-authored source",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "template": "nsis/installer.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyNzc5MzVGMDQ0MzQzRTcKUldUblEwTUVYNU4zY3QwOTlMTVh3bDZvS2gyZ1R2VzdKQXJzaDAzVnJIOGd5NUZONVMyNkFGS0MK",
      "endpoints": [
        "https://github.com/pohoc/PoTools/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/pohoc/PoTools/releases/latest/download/latest-cn.json",
        "https://ghfast.top/https://github.com/pohoc/PoTools/releases/latest/download/latest-cn-ghfast.json"
      ]
    }
  }
}
